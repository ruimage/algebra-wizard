    subgraph HIGH["5. Высшие степени"]
        HighTarget[Цель:<br>Понизить степень]
        HighQ1[Биквадратное?]
        HighAct1[Замена x² = t при t >= 0<br>Решить для t, затем вернуться к x]
        HighQ2[Есть свободное число c?]
        HighAct2[Вынести X в меньшей степени<br>Произведение = 0: каждый множитель приравнять к 0]
